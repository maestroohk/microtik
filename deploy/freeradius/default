server default {
	listen {
		type = auth
		ipaddr = *
		port = 1812
	}

	listen {
		type = acct
		ipaddr = *
		port = 1813
	}

	authorize {
		filter_username
		preprocess
		chap
		mschap
		sql
		if (notfound) {
			update reply {
				&Reply-Message := "Unknown account"
			}
			reject
		}
		if (fail) {
			update reply {
				&Reply-Message := "Service temporarily unavailable"
			}
			reject
		}
		pap
	}

	authenticate {
		Auth-Type PAP {
			pap
		}
		Auth-Type CHAP {
			chap
		}
		Auth-Type mschap {
			mschap
		}
	}

	preacct {
		preprocess
		acct_unique
	}

	accounting {
		sql
		if (noop) {
			ok
		}
	}

	session {
		sql
	}

	post-auth {
		sql
		Post-Auth-Type REJECT {
			if (&control:Auth-Type == Reject || &reply:Reply-Message =~ /already logged in/) {
				update request {
					&Tmp-String-1 := "Policy-Reject"
				}
			}
			sql
			attr_filter.access_reject
		}
	}
}
