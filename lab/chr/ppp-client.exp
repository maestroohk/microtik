log_user 0
set send_slow {1 0.05}
set timeout 300
set password $env(PPP_CLIENT_ADMIN_PASSWORD)
set prompt {\] > $}

proc step {message} {
    send_user "ppp-client: $message\n"
}

spawn nc 127.0.0.1 5556
sleep 2
send "\r"
expect {
    -ex "Login:" { send "admin\r"; exp_continue }
    -ex "Password:" { send "\r"; exp_continue }
    -re {software license.*\[Y/n\]} { send "n\r"; exp_continue }
    -ex "repeat new password>" { sleep 1; send -s "$password\r"; exp_continue }
    -ex "new password>" { sleep 1; send -s "$password\r"; exp_continue }
    -re $prompt {}
    timeout { step "no shell prompt"; exit 2 }
}
step "logged in"

send -s "/interface pppoe-client add name=pppoe-kibo interface=ether1 service-name=kibo user=\"$env(PPP_USER)\" password=\"$env(PPP_PASSWORD)\" add-default-route=yes use-peer-dns=yes disabled=no\r"
expect -re $prompt
step "pppoe client added"
send "/quit\r"
expect eof
