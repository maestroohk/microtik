@page "/platform"
@attribute [Authorize]
@using Kibo.Web.Features.Platform
@inject TenantService Tenants
@inject CurrentUser CurrentUser

<PageHeader Title="Operators" Subtitle="Independent hotspot and ISP businesses on this platform. Each one only ever sees its own data.">
    <Actions>
        @if (CurrentUser.IsPlatformAdmin)
        {
            <button class="btn btn-primary" @onclick="() => creating = !creating"><Icon Name="plus" /> New operator</button>
        }
    </Actions>
</PageHeader>

@if (!CurrentUser.IsPlatformAdmin)
{
    <div class="card"><EmptyState Icon="shield" Title="Platform administrators only" /></div>
    return;
}

@if (!Tenants.PlatformAccessReady)
{
    <div class="card"><EmptyState Icon="shield" Title="Turn on two-step sign-in first"
        Text="Operator management needs a sign-in with an authenticator code. Set it up under Sign-in security, then sign in again." /></div>
    <a class="btn btn-primary mt-4" href="/account/security">Open sign-in security</a>
    return;
}

@if (message != null)
{
    <div class="mb-5"><Notice Kind="@(messageOk ? "ok" : "bad")" Text="@message" /></div>
}

@if (creating)
{
    <section class="card mb-6">
        <div class="card-header"><div class="card-title">Register an operator</div></div>
        <EditForm Model="form" OnValidSubmit="CreateAsync" class="grid gap-4 p-5 sm:grid-cols-2 xl:grid-cols-4">
            <DataAnnotationsValidator />
            <div><label class="label" for="tname">Business name</label><InputText id="tname" class="input" @bind-Value="form.Name" /><ValidationMessage For="() => form.Name" /></div>
            <div><label class="label" for="tslug">Short name (URL)</label><InputText id="tslug" class="input num" @bind-Value="form.Slug" placeholder="mbarara-net" /><ValidationMessage For="() => form.Slug" /></div>
            <div><label class="label" for="tsite">First site</label><InputText id="tsite" class="input" @bind-Value="form.FirstSiteName" placeholder="Town centre" /></div>
            <div>
                <label class="label" for="tplan">Plan</label>
                <InputSelect id="tplan" class="input" @bind-Value="form.Plan">
                    @foreach (var plan in Enum.GetValues<TenantPlan>()) { <option value="@plan">@plan</option> }
                </InputSelect>
            </div>
            <div><label class="label" for="towner">Owner name</label><InputText id="towner" class="input" @bind-Value="form.OwnerName" /></div>
            <div><label class="label" for="temail">Owner email</label><InputText id="temail" class="input" @bind-Value="form.OwnerEmail" /><ValidationMessage For="() => form.OwnerEmail" /></div>
            <div><label class="label" for="tpass">Temporary password</label><InputText id="tpass" type="password" class="input" @bind-Value="form.OwnerPassword" autocomplete="new-password" /><ValidationMessage For="() => form.OwnerPassword" /></div>
            <div><label class="label" for="tmax">Router limit</label><InputNumber id="tmax" class="input num" @bind-Value="form.MaxRouters" /></div>
            <div class="flex items-center gap-4 sm:col-span-2 xl:col-span-4">
                <label class="flex items-center gap-2 text-[13px]"><InputCheckbox @bind-Value="form.PppoeEnabled" /> PPPoE included</label>
                <button class="btn btn-primary ml-auto" type="submit">Create operator</button>
            </div>
        </EditForm>
    </section>
}

<div class="card overflow-hidden">
    @if (tenants == null)
    {
        <div class="p-5"><div class="skeleton h-4 w-1/2"></div></div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="table">
                <thead><tr><th>Operator</th><th>Plan</th><th class="right">Routers</th><th class="right">Customers</th><th class="right">Active subs</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var t in tenants)
                    {
                        <tr>
                            <td><div class="font-medium">@t.Tenant.Name</div><div class="text-[12px] text-muted">@t.Tenant.ContactEmail · since @t.Tenant.CreatedAt.ToString("MMM yyyy")</div></td>
                            <td>
                                @if (editing == t.Tenant.Id)
                                {
                                    <div class="flex min-w-[300px] flex-wrap items-center gap-2">
                                        <select class="input h-8 w-32" @bind="editPlan">@foreach (var plan in Enum.GetValues<TenantPlan>()) { <option value="@plan">@plan</option> }</select>
                                        <input class="input h-8 w-16 num" type="number" @bind="editRouters" aria-label="Router limit" />
                                        <label class="flex items-center gap-1 text-[12px]"><input type="checkbox" @bind="editPppoe" /> PPPoE</label>
                                        <label class="flex items-center gap-1 text-[12px]"><input type="checkbox" @bind="editAgents" /> Agents</label>
                                        <button class="btn btn-primary btn-sm" @onclick="() => SavePlanAsync(t.Tenant.Id)">Save</button>
                                    </div>
                                }
                                else
                                {
                                    <button class="text-left" @onclick="() => StartEdit(t.Tenant)">
                                        <span class="badge badge-primary">@t.Tenant.Plan</span>
                                        <div class="mt-1 text-[11.5px] text-muted">@t.Tenant.MaxRouters routers@(t.Tenant.PppoeEnabled ? " · PPPoE" : "")@(t.Tenant.AgentsEnabled ? " · agents" : "")</div>
                                    </button>
                                }
                            </td>
                            <td class="right num">@t.Routers / @t.Tenant.MaxRouters</td>
                            <td class="right num">@t.Customers</td>
                            <td class="right num">@t.ActiveSubscriptions</td>
                            <td>
                                @if (t.Tenant.Status == TenantStatus.Active)
                                {
                                    <span class="badge badge-ok badge-dot">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-bad badge-dot">Suspended</span>
                                    <div class="mt-1 max-w-[200px] text-[11.5px] text-muted">@t.Tenant.SuspensionReason</div>
                                }
                            </td>
                            <td class="right">
                                @if (t.Tenant.Status == TenantStatus.Active)
                                {
                                    @if (suspending == t.Tenant.Id)
                                    {
                                        <div class="flex min-w-[260px] justify-end gap-1.5">
                                            <input class="input h-8" placeholder="Reason shown to operator" @bind="suspendReason" />
                                            <button class="btn btn-danger btn-sm" @onclick="() => SetSuspendedAsync(t.Tenant.Id, true)">Suspend</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-ghost btn-sm" @onclick="() => { suspending = t.Tenant.Id; suspendReason = string.Empty; }">Suspend…</button>
                                    }
                                }
                                else
                                {
                                    <button class="btn btn-sm" @onclick="() => SetSuspendedAsync(t.Tenant.Id, false)">Restore</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
<p class="mt-3 text-[12px] text-faint">Suspending an operator blocks their staff sign-ins and makes RADIUS reject their customers at the next login. Data is kept.</p>

@code {
    private List<TenantSummary>? tenants;
    private bool creating;
    private TenantForm form = new();
    private Guid? suspending;
    private string suspendReason = "";
    private Guid? editing;
    private TenantPlan editPlan;
    private int editRouters;
    private bool editPppoe;
    private bool editAgents;
    private string? message;
    private bool messageOk;

    protected override async Task OnInitializedAsync()
    {
        if (Tenants.PlatformAccessReady)
        {
            tenants = await Tenants.ListAsync();
        }
    }

    private void StartEdit(Tenant tenant)
    {
        editing = tenant.Id;
        editPlan = tenant.Plan;
        editRouters = tenant.MaxRouters;
        editPppoe = tenant.PppoeEnabled;
        editAgents = tenant.AgentsEnabled;
    }

    private async Task CreateAsync()
    {
        var result = await Tenants.CreateAsync(form);
        messageOk = result.Succeeded;
        message = result.Succeeded ? $"{result.Value!.Name} created. The owner can sign in now." : result.Error;
        if (result.Succeeded)
        {
            form = new TenantForm();
            creating = false;
        }

        tenants = await Tenants.ListAsync();
    }

    private async Task SavePlanAsync(Guid id)
    {
        var result = await Tenants.UpdatePlanAsync(id, editPlan, editRouters, editPppoe, editAgents);
        messageOk = result.Succeeded;
        message = result.Succeeded ? "Plan updated." : result.Error;
        editing = null;
        tenants = await Tenants.ListAsync();
    }

    private async Task SetSuspendedAsync(Guid id, bool suspended)
    {
        var result = await Tenants.SetSuspendedAsync(id, suspended, suspendReason);
        messageOk = result.Succeeded;
        message = result.Succeeded ? (suspended ? "Operator suspended." : "Operator restored.") : result.Error;
        suspending = null;
        tenants = await Tenants.ListAsync();
    }
}
