@page "/p/{Slug}/voucher"
@layout PortalLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [AllowAnonymous]
@using Kibo.Web.Features.Portal
@inject PortalService Portal
@inject IHttpContextAccessor HttpAccessor
@inject NavigationManager Navigation

@if (site == null)
{
    <PortalMissing />
    return;
}

<PortalFrame Site="site" ShowBack="true">
    <h1 class="text-[22px] font-semibold">Enter your voucher</h1>
    <p class="mt-1 text-[var(--portal-muted)]">Type the code printed on your ticket.</p>
    <form method="post" @formname="voucher" @onsubmit="SubmitAsync" class="mt-5 space-y-4">
        <AntiforgeryToken />
        <input name="Code" value="@(Code ?? QueryCode)" class="portal-input font-mono uppercase tracking-[0.25em]" autocomplete="off"
               autocapitalize="characters" spellcheck="false" placeholder="ABCD-2345" aria-label="Voucher code" required />
        @if (error != null)
        {
            <p class="rounded-xl bg-[color-mix(in_oklab,#c0344a_10%,var(--portal-card))] px-4 py-3 text-[14px]" role="alert">@error</p>
        }
        <button type="submit" class="portal-btn">Connect</button>
    </form>
</PortalFrame>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromForm] public string? Code { get; set; }
    [SupplyParameterFromQuery(Name = "code")] public string? QueryCode { get; set; }

    private PortalSite? site;
    private string? error;

    protected override async Task OnInitializedAsync() => site = await Portal.LoadSiteAsync(Slug);

    private void SubmitAsync()
    {
        var code = Portal.NormalizeVoucherCode(Code);
        if (code == null)
        {
            error = "That does not look like a voucher code. Check the letters and numbers on your ticket.";
            return;
        }

        var loginUrl = Portal.BuildRouterLoginUrl(Portal.ReadContext(HttpAccessor.HttpContext!), code, code);
        if (loginUrl == null)
        {
            error = "Reconnect to the WiFi network first, then open any website to get back to this page.";
            return;
        }

        Navigation.NavigateTo(loginUrl);
    }
}
