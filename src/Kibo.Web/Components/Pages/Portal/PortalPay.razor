@page "/p/{Slug}/pay/{Token}"
@layout PortalLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [AllowAnonymous]
@using Kibo.Web.Features.Customers
@using Kibo.Web.Features.Payments
@using Kibo.Web.Features.Portal
@inject PortalService Portal
@inject PaymentService Payments
@inject IHttpContextAccessor HttpAccessor
@inject NavigationManager Navigation

@if (site == null || payment == null || payment.TenantId != site.Site.TenantId)
{
    <PortalMissing />
    return;
}

@if (payment.Status is PaymentStatus.Pending or PaymentStatus.Created)
{
    <HeadContent><meta http-equiv="refresh" content="4" /></HeadContent>
}

<PortalFrame Site="site" ShowBack="@(payment.Status != PaymentStatus.Succeeded)">
    @switch (payment.Status)
    {
        case PaymentStatus.Pending or PaymentStatus.Created:
            <div class="portal-card px-6 py-8 text-center">
                <div class="portal-spinner mx-auto" role="status" aria-label="Waiting for approval"></div>
                <h1 class="mt-6 text-[21px] font-semibold">Approve on your phone</h1>
                <p class="mt-2 text-[var(--portal-muted)]">
                    We sent a payment prompt for <b class="text-[var(--portal-ink)]">@payment.Currency @payment.Amount.ToString("#,0")</b>
                    to <b class="text-[var(--portal-ink)] tabular-nums">@PhoneNumbers.Display(payment.PhoneNumber)</b>. Enter your PIN to confirm.
                </p>
                <p class="mt-4 text-[12.5px] text-[var(--portal-muted)]">This page updates by itself. Reference <span class="font-mono">@payment.Reference</span></p>
            </div>
            <form method="post" @formname="check" @onsubmit="CheckAsync" class="mt-4">
                <AntiforgeryToken />
                <button class="portal-btn portal-btn-secondary" type="submit">I have approved it</button>
            </form>
            break;

        case PaymentStatus.Succeeded:
            <div class="portal-card overflow-hidden">
                <div class="bg-[var(--accent)] px-6 py-7 text-center text-white">
                    <div class="mx-auto grid size-12 place-items-center rounded-full bg-white/20"><Icon Name="check" Size="26" Stroke="2.5" /></div>
                    <h1 class="mt-3 text-[21px] font-semibold">Payment received</h1>
                    <p class="mt-1 text-white/85">@payment.Currency @payment.Amount.ToString("#,0") · Ref @payment.Reference</p>
                </div>
                <div class="space-y-4 p-5">
                    @if (loginUrl != null)
                    {
                        <a class="portal-btn" href="@loginUrl"><Icon Name="wifi" Size="18" Stroke="2" /> Connect now</a>
                    }
                    else
                    {
                        <p class="rounded-xl bg-[var(--portal-soft)] px-4 py-3 text-[14px]">Reconnect to the WiFi network, then sign in with the details below.</p>
                    }
                    @if (account != null)
                    {
                        <div class="rounded-xl border border-dashed border-[var(--portal-line)] p-4">
                            <div class="text-[12.5px] text-[var(--portal-muted)]">To use another device, sign in with</div>
                            <div class="mt-2 flex items-center justify-between">
                                <span class="text-[13px] text-[var(--portal-muted)]">Phone</span>
                                <span class="font-semibold tabular-nums">@PhoneNumbers.Display(account.Username)</span>
                            </div>
                            <div class="mt-1 flex items-center justify-between">
                                <span class="text-[13px] text-[var(--portal-muted)]">Access code</span>
                                <span class="font-mono text-[20px] font-semibold tracking-[0.2em]">@account.Password</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
            break;

        default:
            <div class="portal-card px-6 py-8 text-center">
                <div class="mx-auto grid size-12 place-items-center rounded-full bg-[color-mix(in_oklab,#c0344a_12%,var(--portal-card))] text-[#c0344a]"><Icon Name="x" Size="24" Stroke="2.5" /></div>
                <h1 class="mt-4 text-[21px] font-semibold">@(payment.Status == PaymentStatus.Expired ? "Payment timed out" : "Payment not completed")</h1>
                <p class="mt-2 text-[var(--portal-muted)]">@(payment.FailureReason ?? "The payment was not approved.") You have not been charged for internet access.</p>
            </div>
            <a class="portal-btn mt-4" href="/p/@Slug/buy/@payment.PackageId">Try again</a>
            break;
    }
</PortalFrame>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string Token { get; set; } = "";

    private PortalSite? site;
    private Payment? payment;
    private AccessAccount? account;
    private string? loginUrl;

    protected override async Task OnInitializedAsync()
    {
        site = await Portal.LoadSiteAsync(Slug);
        payment = await Payments.FindByPortalTokenAsync(Token, CancellationToken.None);
        if (site == null || payment == null || payment.Status != PaymentStatus.Succeeded || payment.AccessAccountId == null)
        {
            return;
        }

        account = await Portal.GetAccountAsync(payment.TenantId, payment.AccessAccountId.Value);
        if (account != null)
        {
            loginUrl = Portal.BuildRouterLoginUrl(Portal.ReadContext(HttpAccessor.HttpContext!), account.Username, account.RouterSecret, site!.TrustedLoginHosts);
        }
    }

    private async Task CheckAsync()
    {
        if (payment != null)
        {
            await Payments.VerifyAndSettleAsync(payment.Id, CancellationToken.None);
        }

        Navigation.NavigateTo($"/p/{Slug}/pay/{Token}");
    }
}
