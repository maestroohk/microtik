<div class="card p-4">
    <div class="flex items-center justify-between">
        <span class="text-[12.5px] font-medium text-muted">@Label</span>
        @if (!string.IsNullOrEmpty(Icon))
        {
            <span class="text-faint"><Icon Name="@Icon" /></span>
        }
    </div>
    <div class="mt-2 text-[26px] font-semibold leading-none tracking-tight tabular-nums">@Value</div>
    <div class="mt-2 min-h-[18px] text-[12px] text-muted">@Detail</div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public RenderFragment? Detail { get; set; }
    [Parameter] public string? Icon { get; set; }
}
