<PageTitle>@Title · Kibo</PageTitle>
<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div class="min-w-0">
        @if (Breadcrumb != null)
        {
            <div class="mb-1.5 flex items-center gap-1 text-[12.5px] text-muted">@Breadcrumb</div>
        }
        <h1 class="truncate text-[22px] font-semibold leading-tight">@Title</h1>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <p class="mt-1 text-[13.5px] text-muted">@Subtitle</p>
        }
    </div>
    @if (Actions != null)
    {
        <div class="flex shrink-0 flex-wrap items-center gap-2">@Actions</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? Breadcrumb { get; set; }
}
